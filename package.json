{
  "name": "gridsmith",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that draws logo marks and magic-circle figures from geometric construction rules.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": "./dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "yarn lint && yarn typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "paper": "^0.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
