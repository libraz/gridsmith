{
  "name": "@libraz/gridsmith",
  "version": "0.1.1",
  "description": "Geometric SVG logo, icon and magic-circle generator: a TypeScript library and MCP server that solves a JSON construction spec, lints it and renders SVG and PNG.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "svg",
    "logo",
    "logo-generator",
    "icon",
    "svg-icons",
    "geometry",
    "geometric-construction",
    "sacred-geometry",
    "magic-circle",
    "png",
    "claude-code",
    "codex"
  ],
  "license": "Apache-2.0",
  "author": "libraz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/gridsmith.git"
  },
  "homepage": "https://github.com/libraz/gridsmith#readme",
  "bugs": {
    "url": "https://github.com/libraz/gridsmith/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": "./dist/cli.js",
  "files": [
    "dist",
    "src",
    "README.md",
    "README_ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "yarn lint && yarn typecheck",
    "test": "vitest run",
    "gallery": "yarn build && node scripts/gallery.js",
    "start": "node dist/cli.js",
    "prepare": "[ -d node_modules/typescript ] && tsc -p tsconfig.build.json || true",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "paper": "^0.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
